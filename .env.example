SUBSONIC_USER=admin
SUBSONIC_PASS=change-me
CACHE_SIZE_GB=10
CACHE_DIR=/data/cache
PORT=4533
# --- Instant playback (YouTube preview via yt-dlp, bundled in the image) ---
# A small lossy preview streams immediately on a cache miss while the
# lossless file (Soulseek first, then YouTube best audio) is fetched into the
# full cache in the background. On by default.
#YOUTUBE_ENABLED=true
# Lossy preview cache budget (separate from CACHE_SIZE_GB); evicted by LRU.
#PREVIEW_SIZE_GB=2
# Path to the yt-dlp binary (default: whatever is on PATH).
#YTDLP_PATH=yt-dlp
# Optional cookies file to get past YouTube bot checks.
#YTDLP_COOKIES=/data/cookies.txt
# Soulseek via slskd: the background lossless source (music-native, often
# fastest for audio). Run slskd (https://slskd.org, needs a free Soulseek
# login), then point these at it. SLSKD_DOWNLOAD_DIR defaults to slskd's own
# container default (/app/downloads) — only set it when slskd uses a custom dir or
# runs outside the compose stack (must be visible locally: same-host bind
# mount or shared volume; slskd has no file-content API).
#SLSKD_URL=http://192.168.1.142:5030
#SLSKD_API_KEY=
#SLSKD_DOWNLOAD_DIR=E:\slskd\downloads
