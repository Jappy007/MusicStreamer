ALLDEBRID_API_KEY=
SUBSONIC_USER=admin
SUBSONIC_PASS=change-me
CACHE_SIZE_GB=10
CACHE_DIR=/data/cache
PROWLARR_URL=
PROWLARR_API_KEY=
PORT=4533
# MIN_SEEDERS (optional, default 0): skip Prowlarr rows reporting fewer
# seeders. 2 is a sane floor; 0 disables filtering.
#MIN_SEEDERS=2
# Soulseek via slskd (optional Tier-3 source, music-native, often fastest
# for audio). Run slskd (https://slskd.org, needs a free Soulseek login),
# then point these at it. The download dir must be the SAME folder slskd
# writes to (local path or mounted volume).
#SLSKD_URL=http://192.168.1.142:5030
#SLSKD_API_KEY=
#SLSKD_DOWNLOAD_DIR=E:\slskd\downloads
# Prowlarr is optional: without it Tier 3 uses built-in public indexes.
# ALLDEBRID_API_KEY is the only key strictly required for playback.
# MUSIC_DIR (optional): local music folder, e.g. Lidarr's output.
# Files already there play instantly without touching AllDebrid.
#MUSIC_DIR=
